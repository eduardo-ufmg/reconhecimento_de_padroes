   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def f(x, m):\n",
    "  return (x - m) ** 2\n",
    "\n",
    "xrange = np.linspace(0, 10, 100)\n",
    "\n",
    "f1 = f(xrange, 3)\n",
    "\n",
    "f2 = f(xrange, 6)\n",
    "\n",
    "plt.plot(xrange, f1)\n",
    "plt.plot(xrange, f2)\n",
    "plt.show()\n",
    "\n",
    "plt.plot(f1, f2)\n",
    "plt.show()"
   ]
  }
 ],
